{
  "name": "Reproductor Stream P2P Continuo",
  "version": "1.0.0",
  "description": "Reproductor web basado en Clappr y SwarmCloud P2P con auto-recuperación (Watchdog), desbloqueo de audio y protección de inspección.",
  "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"robots\" content=\"noindex,nofollow\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Reproductor Stream P2P Continuo</title>\n    \n    <!-- Clappr Player CSS / JS -->\n    <link rel=\"preconnect\" href=\"https://cdn.jsdelivr.net\" crossorigin>\n    <link rel=\"dns-prefetch\" href=\"https://cdn.jsdelivr.net\">\n    <script src=\"https://cdn.jsdelivr.net/npm/@clappr/player@0.8/dist/clappr.min.js\"></script>\n    <!-- SwarmCloud P2P Scripts -->\n    <script src=\"https://cdn.jsdelivr.net/npm/swarmcloud-hls@latest/dist/p2p-engine.min.js\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/swarmcloud-hls@latest/dist/clappr-p2p-plugin.min.js\"></script>\n    \n    <style>\n        html, body {\n            margin: 0;\n            padding: 0;\n            width: 100%;\n            height: 100%;\n            background: #000;\n            overflow: hidden;\n            user-select: none;\n            -webkit-user-select: none;\n            -webkit-touch-callout: none;\n        }\n        #player {\n            position: absolute;\n            inset: 0;\n            width: 100%;\n            height: 100%;\n            background: #000;\n        }\n        #playerError {\n            position: absolute;\n            inset: 0;\n            display: none;\n            align-items: center;\n            justify-content: center;\n            background: rgba(0,0,0,0.85);\n            z-index: 9999;\n            pointer-events: none;\n        }\n        .loader-circle {\n            width: 44px;\n            height: 44px;\n            border: 4px solid rgba(255, 255, 255, 0.18);\n            border-top-color: #00cfff;\n            border-radius: 50%;\n            animation: spinLoader 0.8s linear infinite;\n        }\n        @keyframes spinLoader {\n            from { transform: rotate(0deg); }\n            to { transform: rotate(360deg); }\n        }\n        .media-control[data-media-control] {\n            z-index: 9998 !important;\n        }\n        .media-control[data-media-control] button, \n        .media-control[data-media-control] .button, \n        .media-control[data-media-control] [data-fullscreen] {\n            pointer-events: auto !important;\n            opacity: 1 !important;\n            visibility: visible !important;\n        }\n        .media-control[data-media-control] svg {\n            opacity: 1 !important;\n            visibility: visible !important;\n        }\n        .media-control[data-media-control] .media-control-layer[data-controls] .bar-container[data-seekbar] {\n            height: 5px !important;\n        }\n        .media-control[data-media-control] .media-control-layer[data-controls] .bar-container[data-seekbar] .bar-background[data-seekbar] {\n            height: 5px !important;\n            background: rgba(255, 255, 255, 0.20) !important;\n        }\n        .media-control[data-media-control] .media-control-layer[data-controls] .bar-container[data-seekbar] .bar-fill-1[data-seekbar], \n        .media-control[data-media-control] .media-control-layer[data-controls] .bar-container[data-seekbar] .bar-fill-2[data-seekbar], \n        .media-control[data-media-control] .media-control-layer[data-controls] .bar-container[data-seekbar] .bar-hover[data-seekbar] {\n            height: 5px !important;\n            background: #00cfff !important;\n        }\n        .media-control[data-media-control] .media-control-layer[data-seekbar]:hover {\n            height: 7px !important;\n        }\n        #soundUnlock {\n            position: absolute;\n            top: 8px;\n            right: 10px;\n            z-index: 10000;\n            height: 34px;\n            min-width: 238px;\n            padding: 0 15px;\n            border: 0;\n            border-radius: 0 0 0 10px;\n            background: rgba(0, 0, 0, 0.88);\n            color: #ffffff;\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 12px;\n            font-weight: 900;\n            letter-spacing: 0.45px;\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 9px;\n            backdrop-filter: blur(8px);\n            box-shadow: 0 0 18px rgba(0, 207, 255, 0.20);\n            transition: opacity 0.18s ease, background 0.18s ease, transform 0.18s ease;\n        }\n        #soundUnlock:hover {\n            background: rgba(0, 0, 0, 0.96);\n            transform: scale(1.02);\n        }\n        #soundUnlock.hidden {\n            opacity: 0;\n            pointer-events: none;\n        }\n        #soundUnlock .sound-dot {\n            width: 8px;\n            height: 8px;\n            flex-shrink: 0;\n            border-radius: 50%;\n            background: #00cfff;\n            box-shadow: 0 0 11px rgba(0, 207, 255, 1);\n        }\n        @media (max-width: 600px) {\n            #soundUnlock {\n                top: 6px;\n                right: 6px;\n                min-width: 205px;\n                height: 32px;\n                padding: 0 10px;\n                font-size: 11px;\n                letter-spacing: 0.2px;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div id=\"player\"></div>\n    <button id=\"soundUnlock\" type=\"button\">\n        <span class=\"sound-dot\" aria-hidden=\"true\"></span>\n        <span>CLICK PARA ACTIVAR SONIDO</span>\n    </button>\n    <div id=\"playerError\"><div class=\"loader-circle\"></div></div>\n\n    <script>\n        var playbackURL = \"\";\n\n        var reloadDelay = 1500;\n        var isReconnecting = false;\n        var playerCreated = false;\n        var slowLoadingTimer = null;\n        var soundUnlocked = false;\n        var audioStartedFull = false;\n        var userTouchedVolume = false;\n        var currentVolume = 100;\n\n        // Variables para el Watchdog (Auto-recuperación de stream congelado)\n        var watchdogTimer = null;\n        var lastCurrentTime = -1;\n        var stallCount = 0;\n        var MAX_STALL_COUNT = 4; // Intentos antes de reinicializar únicamente la transmisión\n\n        // Configuración para SwarmCloud P2P + HLS\n        var p2pConfig = {\n            live: true,\n            maxBufferSize: 0,\n            maxBufferLength: 15,\n            liveSyncDurationCount: 3,\n            token: \"\",\n            loader: (typeof P2PEngineHls !== 'undefined') ? P2PEngineHls.EngineLoader : null\n        };\n\n        function showPlayerLoading() {\n            var box = document.getElementById('playerError');\n            if (box) { box.style.display = 'flex'; }\n        }\n        function hidePlayerLoading() {\n            var box = document.getElementById('playerError');\n            if (box) { box.style.display = 'none'; }\n        }\n        function startSmartLoader() {\n            clearTimeout(slowLoadingTimer);\n            slowLoadingTimer = setTimeout(function () { showPlayerLoading(); }, 800);\n        }\n        function stopSmartLoader() {\n            clearTimeout(slowLoadingTimer);\n            hidePlayerLoading();\n        }\n\n        // --- REINICIALIZACIÓN INTERNA DE LA TRANSMISIÓN (SIN REFRESCAR PÁGINA) ---\n        function reconnectStream() {\n            if (isReconnecting) { return; }\n            isReconnecting = true;\n            showPlayerLoading();\n\n            // Detener el temporizador de monitoreo durante la reconexión\n            clearInterval(watchdogTimer);\n\n            // Destruir la instancia actual de Clappr si existe\n            if (window.player) {\n                try {\n                    window.player.destroy();\n                } catch (e) {\n                    console.warn(\"Error destruyendo el reproductor anterior:\", e);\n                }\n                window.player = null;\n            }\n\n            // Recrear el contenedor HTML del reproductor\n            var playerDiv = document.getElementById('player');\n            if (playerDiv) {\n                playerDiv.innerHTML = '';\n            }\n\n            // Resetear estados operativos\n            playerCreated = false;\n            stallCount = 0;\n            lastCurrentTime = -1;\n\n            // Esperar un breve intervalo para re-crear la transmisión de forma limpia\n            setTimeout(function () {\n                isReconnecting = false;\n                createClapprPlayer();\n            }, reloadDelay);\n        }\n\n        // Manejo de fallos del reproductor\n        function handlePlayerFail(e) {\n            console.warn('Advertencia o error en transmisión. Intentando recuperar...', e);\n            showPlayerLoading();\n\n            var player = window.player;\n            if (player && typeof player.getPlayback === 'function') {\n                var playback = player.getPlayback();\n                // Intenta recuperar mediante la instancia HLS interna\n                if (playback && playback._hls) {\n                    try {\n                        playback._hls.startLoad();\n                        playback._hls.recoverMediaError();\n                        playWithoutInterruption(player);\n                        return;\n                    } catch (err) {\n                        console.error(\"Falló la autorecuperación HLS:\", err);\n                    }\n                }\n            }\n            // Si la recuperación HLS falla, reinicializa únicamente el flujo de streaming\n            reconnectStream();\n        }\n\n        function clampVolume(v) {\n            v = parseInt(v, 10);\n            if (isNaN(v)) { v = 100; }\n            return Math.max(0, Math.min(100, v));\n        }\n        function getNativeVideo() {\n            return document.querySelector('#player video');\n        }\n        function applyVolumeToNativeVideo(volume) {\n            var video = getNativeVideo();\n            if (!video) { return; }\n            volume = clampVolume(volume);\n            try {\n                video.volume = volume / 100;\n                video.muted = !soundUnlocked || volume <= 0;\n            } catch (e) {}\n        }\n        function setPlayerVolumeHard(player, volume, markUser) {\n            volume = clampVolume(volume);\n            currentVolume = volume;\n            if (markUser) { userTouchedVolume = true; }\n            try {\n                if (player && typeof player.setVolume === 'function') { player.setVolume(volume); }\n                if (soundUnlocked && volume > 0) {\n                    if (player && typeof player.unmute === 'function') { player.unmute(); }\n                } else {\n                    if (player && typeof player.mute === 'function') { player.mute(); }\n                }\n            } catch (e) {}\n            applyVolumeToNativeVideo(volume);\n        }\n        function startAudioFullOnce(player) {\n            if (!soundUnlocked || audioStartedFull || userTouchedVolume) { return; }\n            audioStartedFull = true;\n            setPlayerVolumeHard(player, 100, false);\n        }\n        function syncVolumeFromClappr(player) {\n            if (!player) { return; }\n            try {\n                if (typeof player.getVolume === 'function') {\n                    var v = player.getVolume();\n                    if (!isNaN(v)) {\n                        currentVolume = clampVolume(v);\n                        applyVolumeToNativeVideo(currentVolume);\n                    }\n                }\n            } catch (e) {}\n        }\n        function playWithoutInterruption(player) {\n            if (!player) { return; }\n            try {\n                if (typeof player.isPlaying !== 'function' || !player.isPlaying()) {\n                    var result = player.play();\n                    if (result && typeof result.catch === 'function') { result.catch(function () {}); }\n                }\n            } catch (e) {}\n            var video = getNativeVideo();\n            if (video && video.paused) {\n                try {\n                    var nativeResult = video.play();\n                    if (nativeResult && typeof nativeResult.catch === 'function') { nativeResult.catch(function () {}); }\n                } catch (e) {}\n            }\n        }\n\n        // --- MONITOREO Y AUTORRECUPERACIÓN ---\n        function startWatchdog() {\n            clearInterval(watchdogTimer);\n            watchdogTimer = setInterval(function () {\n                var video = getNativeVideo();\n                if (!video) { return; }\n\n                if (!video.paused && !video.ended) {\n                    if (video.currentTime === lastCurrentTime) {\n                        stallCount++;\n                        showPlayerLoading();\n                        \n                        if (window.player) { playWithoutInterruption(window.player); }\n\n                        if (stallCount >= MAX_STALL_COUNT) {\n                            console.warn(\"Transmisión congelada. Reiniciando streaming...\");\n                            reconnectStream();\n                        }\n                    } else {\n                        stallCount = 0;\n                        lastCurrentTime = video.currentTime;\n                        hidePlayerLoading();\n                    }\n                }\n            }, 2000);\n        }\n\n        function unlockSound() {\n            var player = window.player;\n            soundUnlocked = true;\n            audioStartedFull = true;\n            if (player) {\n                setPlayerVolumeHard(player, 100, true);\n                playWithoutInterruption(player);\n            }\n            var button = document.getElementById('soundUnlock');\n            if (button) {\n                button.classList.add('hidden');\n                button.disabled = true;\n                button.setAttribute('aria-hidden', 'true');\n                setTimeout(function () { button.style.display = 'none'; }, 200);\n            }\n        }\n        document.getElementById('soundUnlock').addEventListener('click', unlockSound);\n\n        function bindVolumeFallback() {\n            document.addEventListener('mousedown', function () { userTouchedVolume = true; }, true);\n            document.addEventListener('touchstart', function () { userTouchedVolume = true; }, true);\n        }\n\n        function hasP2PSupport() {\n            return (typeof window.SwarmCloudClapprPlugin !== 'undefined' && typeof window.P2PEngineHls !== 'undefined');\n        }\n\n        function createClapprPlayer() {\n            if (playerCreated) { return; }\n            playerCreated = true;\n\n            var pluginsList = [];\n            var playbackConfig = {\n                hlsjsConfig: {\n                    enableWorker: true,\n                    liveSyncDurationCount: 3,\n                    liveMaxLatencyDurationCount: 10,\n                    maxBufferLength: 15,\n                    maxMaxBufferLength: 30,\n                    manifestLoadingMaxRetry: 10,\n                    manifestLoadingRetryDelay: 1000,\n                    levelLoadingMaxRetry: 10,\n                    levelLoadingRetryDelay: 1000,\n                    fragLoadingMaxRetry: 10,\n                    fragLoadingRetryDelay: 1000\n                }\n            };\n\n            if (hasP2PSupport()) {\n                pluginsList = [window.SwarmCloudClapprPlugin];\n                playbackConfig.hlsjsConfig.p2pConfig = p2pConfig;\n            }\n\n            var player = new Clappr.Player({\n                source: playbackURL,\n                parentId: \"#player\",\n                plugins: pluginsList,\n                width: '100%',\n                height: '100%',\n                autoPlay: true,\n                mute: !soundUnlocked,\n                volume: currentVolume,\n                playsinline: true,\n                mediacontrol: { seekbar: \"#00cfff\", buttons: \"#FFFFFF\" },\n                playback: playbackConfig,\n                events: {\n                    onReady: function () {\n                        if (soundUnlocked) {\n                            setPlayerVolumeHard(player, currentVolume, false);\n                        } else {\n                            startAudioFullOnce(player);\n                        }\n                        stopSmartLoader();\n                        startWatchdog();\n                        setTimeout(function () { syncVolumeFromClappr(player); }, 150);\n                    },\n                    onPlay: function () {\n                        stopSmartLoader();\n                        if (soundUnlocked) {\n                            setPlayerVolumeHard(player, currentVolume, false);\n                        } else if (!userTouchedVolume) {\n                            startAudioFullOnce(player);\n                        } else {\n                            syncVolumeFromClappr(player);\n                        }\n                    },\n                    onVolumeUpdate: function () {\n                        userTouchedVolume = true;\n                        setTimeout(function () { syncVolumeFromClappr(player); }, 20);\n                    },\n                    onError: function (e) { handlePlayerFail(e); },\n                    onPlaybackError: function (e) { handlePlayerFail(e); }\n                }\n            });\n\n            window.player = player;\n\n            setTimeout(function () {\n                applyVolumeToNativeVideo(currentVolume);\n                playWithoutInterruption(player);\n            }, 600);\n        }\n\n        function bootPlayer() {\n            startSmartLoader();\n            createClapprPlayer();\n            bindVolumeFallback();\n        }\n\n        // Bloqueo de inspección y atajos de teclado\n        function isBlockedShortcut(e) {\n            var key = String(e.key || '').toLowerCase();\n            return (e.key === 'F12' || e.keyCode === 123 || (e.ctrlKey && e.shiftKey && (key === 'i' || key === 'j' || key === 'c')) || (e.ctrlKey && key === 's'));\n        }\n        document.addEventListener('contextmenu', function (e) { e.preventDefault(); return false; }, true);\n        document.addEventListener('keydown', function (e) {\n            if (isBlockedShortcut(e)) { e.preventDefault(); return false; }\n        }, true);\n\n        bootPlayer();\n    </script>\n</body>\n</html>"
}
